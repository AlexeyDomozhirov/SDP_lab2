import sympy as sp
import numpy as np
from scipy.optimize import minimize

# Вариант 1
x = sp.symbols('x', positive=True)
y = sp.sin(sp.log(x))

x0 = 4
a = 3
b = 8

# Функция для вывода результата
def print_result(value):
    print(value)

# 1. Первая и вторая производные в точке x0 с помощью sympy
dy = sp.diff(y, x)
d2y = sp.diff(y, x, 2)

print_result(sp.N(dy.subs(x, x0)))
print_result(sp.N(d2y.subs(x, x0)))

# 2. Символьное представление производной
print_result(sp.simplify(dy))

# 3. Определённый интеграл методом прямоугольников
def f_np(t):
    return np.sin(np.log(t))

def rectangle_integral(func, left, right, n=1000000):
    xs = np.linspace(left, right, n + 1)
    mids = (xs[:-1] + xs[1:]) / 2
    return float(np.sum(func(mids)) * (right - left) / n)

print_result(rectangle_integral(f_np, a, b))

# 4. Неопределённый интеграл с помощью sympy
F = sp.integrate(y, x)
print_result(sp.simplify(F))

# 5. Нелинейная оптимизация
def objective(v):
    x1, x2 = v
    return (x1 - 3) ** 2 + x2

def constraint(v):
    x1, x2 = v
    return -2 * x1 + 3 * x2 - 4

res = minimize(
    objective,
    [1.0, 2.0],
    method='SLSQP',
    bounds=[(0, None), (0, None)],
    constraints={'type': 'ineq', 'fun': constraint}
)

print_result(res.x[0])
print_result(res.x[1])
print_result(res.fun)
